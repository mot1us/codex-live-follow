{
  "name": "codex-live-follow",
  "displayName": "Codex Live Follow",
  "description": "Watch your agent work in VS Code. Replay saved edits as fast typing or jump straight to changed lines.",
  "version": "0.7.2",
  "publisher": "mot1us",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "codex",
    "live editing",
    "typing",
    "ai",
    "file watcher"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "scripts": {
    "test": "node scripts/unit-tests.js",
    "check": "node scripts/check.js",
    "package": "node scripts/package.js",
    "package:check": "node scripts/check-package.js",
    "vscode:prepublish": "npm run check && npm test",
    "test:integration": "node scripts/test-host.js",
    "test:packaged": "node scripts/test-package-host.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "codexLiveFollow.toggle",
        "title": "Toggle Live Follow",
        "category": "Codex Live Follow"
      },
      {
        "command": "codexLiveFollow.pause",
        "title": "Pause Following",
        "category": "Codex Live Follow"
      },
      {
        "command": "codexLiveFollow.resume",
        "title": "Resume Following",
        "category": "Codex Live Follow"
      },
      {
        "command": "codexLiveFollow.controls",
        "title": "Open Controls",
        "category": "Codex Live Follow"
      },
      {
        "command": "codexLiveFollow.setSpeed",
        "title": "Choose Typing Speed",
        "category": "Codex Live Follow"
      },
      {
        "command": "codexLiveFollow.setMode",
        "title": "Choose Replay Mode",
        "category": "Codex Live Follow"
      },
      {
        "command": "codexLiveFollow.skipReplay",
        "title": "Skip Current Replay",
        "category": "Codex Live Follow"
      },
      {
        "command": "codexLiveFollow.showOutput",
        "title": "Show Logs",
        "category": "Codex Live Follow"
      },
      {
        "command": "codexLiveFollow.openSidebar",
        "title": "Open Live Follow Sidebar",
        "category": "Codex Live Follow"
      },
      {
        "command": "codexLiveFollow.settings",
        "title": "Extension Settings",
        "category": "Codex Live Follow",
        "icon": "$(settings-gear)"
      }
    ],
    "configuration": {
      "title": "Codex Live Follow",
      "properties": {
        "codexLiveFollow.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Follow saved edits in this project. Use Live Follow in the activity bar to pause or resume."
        },
        "codexLiveFollow.mode": {
          "type": "string",
          "enum": [
            "typing",
            "follow"
          ],
          "default": "typing",
          "description": "Show saved edits as typing, or jump straight to changed lines. Typing uses a read-only preview."
        },
        "codexLiveFollow.typingCharsPerSecond": {
          "type": "number",
          "default": 120,
          "minimum": 20,
          "maximum": 400,
          "description": "Typing replay speed in characters per second."
        },
        "codexLiveFollow.maxReplayCharacters": {
          "type": "number",
          "default": 20000,
          "minimum": 100,
          "maximum": 100000,
          "description": "Skip typing for changes above this size. Smaller changes still follow the replay time limit."
        },
        "codexLiveFollow.maxReplayDurationMs": {
          "type": "number",
          "default": 12000,
          "minimum": 1000,
          "maximum": 60000,
          "description": "Time limit for each typing replay, in milliseconds. Long edits speed up to fit."
        },
        "codexLiveFollow.highlightDurationMs": {
          "type": "number",
          "default": 1400,
          "minimum": 250,
          "maximum": 10000,
          "description": "How long changed lines stay highlighted, in milliseconds."
        },
        "codexLiveFollow.minimumDisplayMs": {
          "type": "number",
          "default": 450,
          "minimum": 100,
          "maximum": 5000,
          "description": "How long to show each changed block before moving on, in milliseconds."
        },
        "codexLiveFollow.inspectionDisplayMs": {
          "type": "number",
          "default": 1500,
          "minimum": 300,
          "maximum": 10000,
          "description": "How long to show each file and line your agent reports, in milliseconds."
        },
        "codexLiveFollow.maxFileSizeKB": {
          "type": "number",
          "default": 512,
          "minimum": 16,
          "maximum": 4096,
          "description": "Skip files larger than this size, in KB."
        },
        "codexLiveFollow.pauseOnInteraction": {
          "type": "boolean",
          "default": true,
          "description": "Pause when you type, click in an editor, or switch files."
        },
        "codexLiveFollow.idleDelayMs": {
          "type": "number",
          "default": 3000,
          "minimum": 500,
          "maximum": 60000,
          "description": "Wait this many milliseconds after you stop editing before following again."
        },
        "codexLiveFollow.pauseWhenUnfocused": {
          "type": "boolean",
          "default": true,
          "description": "Wait while VS Code is in the background."
        },
        "codexLiveFollow.ignoreEditorSaves": {
          "type": "boolean",
          "default": true,
          "description": "Skip saves made in this VS Code window. Follow edits saved by other tools."
        },
        "codexLiveFollow.excludeDirectories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [],
          "description": "Extra folder names to skip. Dependency and build folders are already skipped."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexLiveFollow",
          "title": "Live Follow",
          "icon": "assets/sidebar.svg"
        }
      ]
    },
    "views": {
      "codexLiveFollow": [
        {
          "type": "webview",
          "id": "codexLiveFollow.sidebar",
          "name": "Controls"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "codexLiveFollow.settings",
          "when": "view == codexLiveFollow.sidebar",
          "group": "navigation"
        }
      ]
    }
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Requires a workspace extension host with file watching support."
    }
  },
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/mot1us/codex-live-follow.git"
  },
  "homepage": "https://github.com/mot1us/codex-live-follow#readme",
  "bugs": {
    "url": "https://github.com/mot1us/codex-live-follow/issues"
  }
}
