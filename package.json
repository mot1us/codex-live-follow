{
  "name": "codex-live-follow",
  "displayName": "Specter",
  "description": "Replays saved file changes as typing in VS Code. Runs locally, with no AI or network connection.",
  "version": "0.9.5",
  "publisher": "mot1us",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "specter",
    "codex",
    "coding agents",
    "typing",
    "file watcher"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "scripts": {
    "test": "node scripts/unit-tests.js",
    "check": "node scripts/check.js",
    "package": "node scripts/package.js",
    "package:check": "node scripts/check-package.js",
    "vscode:prepublish": "npm run check && npm test",
    "test:integration": "node scripts/test-host.js",
    "test:packaged": "node scripts/test-package-host.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "codexLiveFollow.toggle",
        "title": "Toggle Replay",
        "category": "Specter"
      },
      {
        "command": "codexLiveFollow.pause",
        "title": "Pause Replay",
        "category": "Specter"
      },
      {
        "command": "codexLiveFollow.resume",
        "title": "Resume Replay",
        "category": "Specter"
      },
      {
        "command": "codexLiveFollow.controls",
        "title": "Open Controls",
        "category": "Specter"
      },
      {
        "command": "codexLiveFollow.setSpeed",
        "title": "Choose Typing Speed",
        "category": "Specter"
      },
      {
        "command": "codexLiveFollow.setMode",
        "title": "Choose Edit Display",
        "category": "Specter"
      },
      {
        "command": "codexLiveFollow.skipReplay",
        "title": "Skip Current Replay",
        "category": "Specter"
      },
      {
        "command": "codexLiveFollow.showOutput",
        "title": "Show Logs",
        "category": "Specter"
      },
      {
        "command": "codexLiveFollow.openSidebar",
        "title": "Open Specter Sidebar",
        "category": "Specter"
      },
      {
        "command": "codexLiveFollow.settings",
        "title": "Extension Settings",
        "category": "Specter",
        "icon": "$(settings-gear)"
      },
      {
        "command": "codexLiveFollow.replayRecent",
        "title": "Replay a Recent Edit",
        "category": "Specter"
      },
      {
        "command": "codexLiveFollow.clearRecent",
        "title": "Clear Recent Edits",
        "category": "Specter"
      },
      {
        "command": "codexLiveFollow.ignore",
        "title": "Ignore in Specter",
        "category": "Specter"
      },
      {
        "command": "codexLiveFollow.setupInspection",
        "title": "Set Up Inspections",
        "category": "Specter"
      },
      {
        "command": "codexLiveFollow.testSpecter",
        "title": "Test Specter",
        "category": "Specter"
      }
    ],
    "configuration": {
      "title": "Specter",
      "properties": {
        "codexLiveFollow.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show saved file changes in this project. Pause and resume in the Specter sidebar."
        },
        "codexLiveFollow.mode": {
          "type": "string",
          "enum": [
            "typing",
            "follow"
          ],
          "default": "typing",
          "description": "Play back saved edits as typing, or go straight to changed lines. The typing preview is read-only."
        },
        "codexLiveFollow.typingCharsPerSecond": {
          "type": "number",
          "default": 120,
          "minimum": 20,
          "maximum": 400,
          "description": "Typing replay speed, in characters per second. Changes affect the current replay immediately."
        },
        "codexLiveFollow.maxReplayCharacters": {
          "type": "number",
          "default": 20000,
          "minimum": 100,
          "maximum": 100000,
          "description": "Skip typing for changes above this size. Smaller changes still follow the replay time limit."
        },
        "codexLiveFollow.maxReplayDurationMs": {
          "type": "number",
          "default": 12000,
          "minimum": 1000,
          "maximum": 60000,
          "description": "Time limit for each typing replay, in milliseconds. At the limit, show the complete saved file without increasing the selected speed."
        },
        "codexLiveFollow.highlightDurationMs": {
          "type": "number",
          "default": 1400,
          "minimum": 250,
          "maximum": 10000,
          "description": "How long changed lines stay highlighted, in milliseconds."
        },
        "codexLiveFollow.minimumDisplayMs": {
          "type": "number",
          "default": 450,
          "minimum": 100,
          "maximum": 5000,
          "description": "How long to show each changed block before moving on, in milliseconds."
        },
        "codexLiveFollow.inspectionDisplayMs": {
          "type": "number",
          "default": 1500,
          "minimum": 300,
          "maximum": 10000,
          "description": "How long to stay on a line reported by your agent, in milliseconds."
        },
        "codexLiveFollow.maxFileSizeKB": {
          "type": "number",
          "default": 512,
          "minimum": 16,
          "maximum": 4096,
          "description": "Skip files larger than this size, in KB."
        },
        "codexLiveFollow.pauseOnInteraction": {
          "type": "boolean",
          "default": true,
          "description": "Pause while you type, click, or switch files."
        },
        "codexLiveFollow.suspendWhenPaused": {
          "type": "boolean",
          "default": true,
          "description": "Stop file watching and release source baselines when replay is paused. Resume scans the current files without replaying edits made while paused. Turn off to keep baselines updated during pause."
        },
        "codexLiveFollow.idleDelayMs": {
          "type": "number",
          "default": 3000,
          "minimum": 500,
          "maximum": 60000,
          "description": "Resume after this many milliseconds without editor activity."
        },
        "codexLiveFollow.pauseWhenUnfocused": {
          "type": "boolean",
          "default": true,
          "description": "Wait while VS Code is in the background."
        },
        "codexLiveFollow.ignoreEditorSaves": {
          "type": "boolean",
          "default": true,
          "description": "Skip saves made in this VS Code window. Follow edits saved by other tools."
        },
        "codexLiveFollow.excludeDirectories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [],
          "description": "Extra folder names to skip. Dependency and build folders are already skipped."
        },
        "codexLiveFollow.replayPane": {
          "type": "string",
          "enum": [
            "current",
            "beside"
          ],
          "enumDescriptions": [
            "Use the current editor group.",
            "Keep replay in a separate editor group beside your code."
          ],
          "default": "current",
          "description": "Where replay opens. The separate pane is reused until you close it."
        },
        "codexLiveFollow.excludeGlobs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "maxItems": 200,
          "default": [],
          "scope": "resource",
          "description": "Paths to skip, relative to each project root. Use * and ? within a folder, or ** across folders. Examples: **/*.map, generated/**. Right-click a file or folder to add it."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexLiveFollow",
          "title": "Specter",
          "icon": "assets/sidebar.svg"
        }
      ]
    },
    "views": {
      "codexLiveFollow": [
        {
          "type": "webview",
          "id": "codexLiveFollow.sidebar",
          "name": "Controls"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "codexLiveFollow.settings",
          "when": "view == codexLiveFollow.sidebar",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "codexLiveFollow.ignore",
          "when": "resourceScheme == file",
          "group": "specter@1"
        }
      ],
      "editor/context": [
        {
          "command": "codexLiveFollow.ignore",
          "when": "resourceScheme == file",
          "group": "specter@1"
        }
      ]
    }
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Requires a workspace extension host with file watching support."
    }
  },
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/mot1us/specter.git"
  },
  "homepage": "https://github.com/mot1us/specter#readme",
  "bugs": {
    "url": "https://github.com/mot1us/specter/issues"
  }
}
